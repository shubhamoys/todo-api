# App config
APP_NAME=todo_app
APP_ENV=dev
APP_URL=http://localhost
APP_PORT=8080

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.8:3000
CORS_ALLOWED_METHODS=POST,GET,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Content-Length,Accept-Encoding,X-CSRF-Token,Authorization,accept,origin,Cache-Control,X-Requested-With
CORS_ALLOW_CREDENTIALS=true

# DB config
DB=mongoDB
DB_HOST=0.0.0.0
DB_PORT=27017
DB_NAME=todo_app
DB_USERNAME=XXXXXXX # Keep empty if running mongoDB locally
DB_PASSWORD=XXXXXXX # Keep empty if running mongoDB locally
NEW_URL_PARSER=true
UNIFIED_TOPOLOGY=true
CREATE_INDEX=true

# jwt config
JWT_SECRET=XXXXXXXXXXXXXXXX

# Super Admin seeder data
SUPERADMIN_NAME='Super Admin'
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=supersecurepassword